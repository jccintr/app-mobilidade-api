# Copie para .env e ajuste. Nunca suba o .env para o git.
NODE_ENV=development
PORT=3333
PLATFORM_NAME=Mobilidade
PUBLIC_URL=http://localhost:3333

MONGODB_URI=mongodb://127.0.0.1:27017/mobilidade
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-longo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=30d
# Vazio = libera qualquer origem. Em produção, liste os domínios do painel separados por vírgula.
CORS_ORIGINS=

CODE_TTL_MINUTES=15
CODE_MAX_ATTEMPTS=5
CODE_RESEND_SECONDS=60

# E-mail (sem SMTP, os códigos aparecem no console do servidor)
SMTP_HOST=
SMTP_PORT=465
# 465 usa SSL direto (SMTP_SECURE=true). Para a porta 587 use SMTP_SECURE=false (STARTTLS).
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Remetente, ex.: SMTP_FROM="Minha Operadora <nao-responda@seudominio.com.br>"
SMTP_FROM=

# Arquivos: local (pasta uploads/) ou cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
MAX_DOC_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Corridas
# fake = distância em linha reta (só para desenvolver); google = Google Routes API (paga por requisição)
ROUTING_PROVIDER=fake
# Chave do Google usada PELO SERVIDOR: Places (busca de endereços) e Routes/Directions (rota de navegação nos apps).
# Sem ela a busca não funciona e a rota vira linha reta. Não use a chave restrita a "Apps Android".
GOOGLE_MAPS_API_KEY=
MAX_RIDE_KM=80
DISPATCH_RADIUS_METERS=5000
OFFER_SECONDS=20
DISPATCH_SEARCH_SECONDS=60
MAX_OFFERS=5
LOCATION_MAX_AGE_SECONDS=120

# Usados só pelo "npm run seed"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
